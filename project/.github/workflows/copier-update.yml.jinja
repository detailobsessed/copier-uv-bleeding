name: Copier Update

on:
  workflow_dispatch:
  schedule:
    - cron: "0 5 * * 0"  # Weekly on Sundays at 5am UTC

jobs:
  update:
    runs-on: {% if use_blacksmith_runners %}blacksmith-2vcpu-ubuntu-2404{% else %}ubuntu-latest{% endif %}

    permissions:
      contents: write
      pull-requests: write

    steps:
      - uses: actions/checkout@v6

      - uses: actions-ext/copier-update@v0
        with:
          token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
