name: release

"on":
  workflow_run:
    workflows: [ci]
    types: [completed]
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write
  id-token: write

jobs:
  release:
    if: {% raw %}${{ github.event_name == 'workflow_dispatch' || github.event.workflow_run.conclusion == 'success' }}{% endraw %}
    uses: detailobsessed/ci-components/.github/workflows/semantic-release-uv.yml@main
    with:
      python-version: "3.14"
{%- if not use_blacksmith_runners %}
      runner: ubuntu-latest
{%- endif %}
      pypi-publish: "false"
    secrets: inherit
{%- if publish_to_pypi %}

  pypi-publish:
    needs: release
    if: {% raw %}needs.release.outputs.released == 'true'{% endraw %}
    runs-on: ubuntu-latest
    environment:
      name: pypi
      url: https://pypi.org/p/{{ python_package_distribution_name }}
    permissions:
      contents: read
      id-token: write
    steps:
    - name: Checkout release tag
      uses: actions/checkout@v6
      with:
        ref: {% raw %}${{ needs.release.outputs.tag }}{% endraw %}
    - name: Setup uv
      uses: astral-sh/setup-uv@v7
      with:
        python-version: "3.14"
    - name: Build and publish
      run: |
        uv build
        uv publish
{%- else %}

  # To enable PyPI publishing:
  # 1. Re-run copier with publish_to_pypi=true
  # 2. Set up trusted publisher on PyPI for {{ repository_namespace }}/{{ repository_name }}
  #    - Workflow: release.yml, Environment: pypi
  # 3. Create 'pypi' environment in GitHub repo settings
{%- endif %}
