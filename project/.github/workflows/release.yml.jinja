name: release

"on":
  workflow_run:
    workflows: [ci]
    types: [completed]
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write
  id-token: write

jobs:
  release:
    if: {% raw %}${{ github.event_name == 'workflow_dispatch' || github.event.workflow_run.conclusion == 'success' }}{% endraw %}

    runs-on: {{ "ubuntu-latest" if not use_blacksmith_runners else "blacksmith-4vcpu-ubuntu-2404" }}
    concurrency: release
    outputs:
      released: {% raw %}${{ steps.release.outputs.released }}{% endraw %}

      version: {% raw %}${{ steps.release.outputs.version }}{% endraw %}

      tag: {% raw %}${{ steps.release.outputs.tag }}{% endraw %}

    steps:
    - name: Checkout
      uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      with:
        ref: main
        fetch-depth: 0
        fetch-tags: true

    - name: Setup uv
      uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
      with:
        python-version: "3.14"
        enable-cache: true
        github-token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

    - name: Install dependencies
      run: uv sync --no-default-groups --group maintain

    - name: Semantic Release
      id: release
      env:
        GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      run: |
        set +e
        uv run semantic-release --strict version --changelog --push --tag --vcs-release
        exit_code=$?
        set -e
        if [ $exit_code -eq 0 ]; then
          echo "released=true" >> "$GITHUB_OUTPUT"
          tag=$(git describe --tags --abbrev=0)
          echo "tag=$tag" >> "$GITHUB_OUTPUT"
          echo "version=${tag#v}" >> "$GITHUB_OUTPUT"
        elif [ $exit_code -eq 2 ]; then
          echo "No release needed"
          echo "released=false" >> "$GITHUB_OUTPUT"
        else
          echo "Semantic release failed with exit code $exit_code"
          exit $exit_code
        fi
{%- if publish_to_pypi %}

  pypi-publish:
    needs: release
    if: {% raw %}${{ needs.release.outputs.released == 'true' }}{% endraw %}

    runs-on: ubuntu-latest
    environment:
      name: pypi
      url: https://pypi.org/p/{{ python_package_distribution_name }}
    permissions:
      contents: read
      id-token: write
    steps:
    - name: Checkout release tag
      uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      with:
        ref: {% raw %}${{ needs.release.outputs.tag }}{% endraw %}

    - name: Setup uv
      uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
      with:
        python-version: "3.14"
        github-token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

    - name: Build and publish
      run: |
        uv build
        uv publish
{%- else %}

  # To enable PyPI publishing:
  # 1. Re-run copier with publish_to_pypi=true
  # 2. Set up trusted publisher on PyPI for {{ repository_namespace }}/{{ repository_name }}
  #    - Workflow: release.yml, Environment: pypi
  # 3. Create 'pypi' environment in GitHub repo settings
{%- endif %}
{%- if publish_to_mcp_registry %}

  mcp-registry-publish:
    needs: release
    if: {% raw %}${{ needs.release.outputs.released == 'true' }}{% endraw %}

    permissions:
      id-token: write
      contents: read
    uses: detailobsessed/ci-components/.github/workflows/mcp-registry-publish.yml@main
    with:
      runner: "{{ 'blacksmith-4vcpu-ubuntu-2404' if use_blacksmith_runners else 'ubuntu-latest' }}"
{%- endif %}
